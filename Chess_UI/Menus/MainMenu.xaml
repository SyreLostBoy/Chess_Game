<UserControl x:Class="Chess_UI.Menus.AsMain_Menu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chess_UI"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">

    <Border Style="{StaticResource Border_Style}" Width="450" Height="570">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="80"/>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="80"/>
            </Grid.RowDefinitions>

            <!-- Заголовок -->
            <TextBlock Grid.Row="0" 
                       Text="ШАХМАТЫ" 
                       Style="{StaticResource Text_Style}"
                       FontSize="36"
                       FontWeight="Bold"
                       VerticalAlignment="Center"/>

            <!-- Режим игры -->
            <StackPanel Grid.Row="1" Margin="20, -10">
                <TextBlock Text="РЕЖИМ ИГРЫ:" 
                           Style="{StaticResource Text_Style}"
                           FontSize="16"
                           Margin="0,0,0,5"/>
                
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton x:Name="HumanVsHumanRadio" 
                                 Content="Игрок vs Игрок" 
                                 GroupName="GameMode"
                                 Margin="10,0"
                                 Style="{StaticResource RadioButtonStyle}"/>
                    <RadioButton x:Name="HumanVsBotRadio" 
                                 Content="Игрок vs Бот" 
                                 GroupName="GameMode"
                                 Margin="10,0"
                                 Style="{StaticResource RadioButtonStyle}"
                                 IsChecked="True"/>
                    <RadioButton x:Name="BotVsBotRadio" 
                                 Content="Бот vs Бот" 
                                 GroupName="GameMode"
                                 Margin="10,0"
                                 Style="{StaticResource RadioButtonStyle}"/>
                </StackPanel>
            </StackPanel>

            <!-- Настройки -->
            <Grid Grid.Row="2" Margin="20,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Выбор стороны (только для Human vs Bot) -->
                <StackPanel Grid.Row="0" Margin="0,0,0,20" x:Name="SideSelectionPanel">
                    <TextBlock Text="ИГРАТЬ ЗА:" 
                               Style="{StaticResource Text_Style}"
                               FontSize="16"
                               Margin="0,0,0,5"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <RadioButton x:Name="WhiteSideRadio" 
                                     Content="Белые" 
                                     GroupName="Side"
                                     Margin="10,0"
                                     Style="{StaticResource RadioButtonStyle}"
                                     IsChecked="True"/>
                        <RadioButton x:Name="BlackSideRadio" 
                                     Content="Чёрные" 
                                     GroupName="Side"
                                     Margin="10,0"
                                     Style="{StaticResource RadioButtonStyle}"/>
                        <RadioButton x:Name="RandomSideRadio" 
                                     Content="Случайно" 
                                     GroupName="Side"
                                     Margin="10,0"
                                     Style="{StaticResource RadioButtonStyle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Сложность бота -->
                <StackPanel Grid.Row="1" Margin="0,0,0,20" x:Name="DifficultyPanel">
                    <TextBlock Text="СЛОЖНОСТЬ БОТА:" 
                               Style="{StaticResource Text_Style}"
                               FontSize="16"
                               Margin="0,0,0,5"/>
                    
                    <ComboBox x:Name="DifficultyComboBox"
                              Width="200"
                              Height="30"
                              Style="{StaticResource ComboBoxStyle}">
                        <ComboBoxItem Content="Новичок" Tag="Beginner"/>
                        <ComboBoxItem Content="Любитель" IsSelected="True" Tag="Intermediate"/>
                        <ComboBoxItem Content="Продвинутый" Tag="Advanced"/>
                        <ComboBoxItem Content="Эксперт" Tag="Expert"/>
                        <ComboBoxItem Content="Мастер" Tag="Master"/>
                    </ComboBox>
                </StackPanel>

                <!-- Время на партию -->
                <StackPanel Grid.Row="2" Margin="0,0,0,20">
                    <TextBlock Text="ВРЕМЯ НА ПАРТИЮ:" 
                               Style="{StaticResource Text_Style}"
                               FontSize="16"
                               Margin="0,0,0,5"/>
                    
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <ComboBox x:Name="TimeControlComboBox"
                                  Width="150"
                                  Height="30"
                                  Style="{StaticResource ComboBoxStyle}"
                                  SelectedIndex="3">
                            <ComboBoxItem Content="Без времени"/>
                            <ComboBoxItem Content="1 мин"/>
                            <ComboBoxItem Content="3 мин"/>
                            <ComboBoxItem Content="5 мин"/>
                            <ComboBoxItem Content="10 мин"/>
                            <ComboBoxItem Content="15+10"/>
                            <ComboBoxItem Content="30 мин"/>
                        </ComboBox>
                        
                        <CheckBox x:Name="IncrementCheckBox"
                                  Content="Добавление"
                                  Margin="20,0,0,0"
                                  VerticalAlignment="Center"
                                  Style="{StaticResource CheckBoxStyle}"/>
                    </StackPanel>
                </StackPanel>

                <!-- Дополнительные настройки - используем GroupBox -->
                <GroupBox Grid.Row="3" 
                          Header="ДОПОЛНИТЕЛЬНЫЕ НАСТРОЙКИ"
                          Foreground="{StaticResource Text_Color}"
                          FontFamily="Segoe UI Light"
                          FontSize="14"
                          BorderBrush="{StaticResource Stroke_Color}"
                          BorderThickness="1"
                          Margin="0,10">
                    <StackPanel Margin="10">
                        <CheckBox x:Name="SoundCheckBox" 
                                  Content="Звуки" 
                                  IsChecked="True"
                                  Style="{StaticResource CheckBoxStyle}"
                                  Margin="0,5"/>
                        
                        <CheckBox x:Name="HighlightMovesCheckBox" 
                                  Content="Подсветка ходов" 
                                  IsChecked="True"
                                  Style="{StaticResource CheckBoxStyle}"
                                  Margin="0,5"/>

                        <CheckBox x:Name="ShowLegalMovesCheckBox" 
                                  Content="Показывать легальные ходы" 
                                  IsChecked="True"
                                  Style="{StaticResource CheckBoxStyle}"
                                  Margin="0,5"/>
                    </StackPanel>
                </GroupBox>
            </Grid>

            <!-- Кнопки -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="2">
                <Button x:Name="StartButton" 
                        Content="НАЧАТЬ ИГРУ" 
                        Width="150"
                        Height="40"
                        Style="{StaticResource Button_Style}"
                        FontSize="18"
                        Click="StartButton_Click"
                        Margin="10,0"/>
                
                <Button x:Name="SettingsButton" 
                        Content="НАСТРОЙКИ" 
                        Width="120"
                        Height="35"
                        Style="{StaticResource Button_Style}"
                        Click="SettingsButton_Click"
                        Margin="10,0"/>
                
                <Button x:Name="ExitButton" 
                        Content="ВЫХОД" 
                        Width="100"
                        Height="35"
                        Style="{StaticResource Button_Style}"
                        Click="ExitButton_Click"
                        Margin="10,0"/>
            </StackPanel>
        </Grid>
    </Border>
</UserControl>
