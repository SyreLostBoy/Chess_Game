<UserControl x:Class="Chess_UI.Promotion_Menu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Chess_UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Border Width="275"
            Height="125"
            Style="{StaticResource Border_Style}">
        <Grid RenderOptions.BitmapScalingMode="HighQuality">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="1.5*"/>
            </Grid.RowDefinitions>
            
            <TextBlock Text="ВЫБЕРИТЕ ФИГУРУ"
                       Style="{StaticResource Text_Style}"
                       FontSize="28"/>

            <UniformGrid Grid.Row="1"
                         Rows="1"
                         Columns="4"
                         Cursor="Hand">
                <Image x:Name="Queen_Image"
                       MouseDown="On_Queen_Image_Mouse_Down"
                       Source="/Assets/QueenW.png"/>
                <Image x:Name="Bishop_Image"
                        MouseDown="On_Bishop_Image_Mouse_Down"
                        Source="/Assets/BishopW.png"/>
                <Image x:Name="Rook_Image"
                        MouseDown="On_Rook_Image_Mouse_Down"
                        Source="/Assets/RookW.png"/>
                <Image x:Name="Knight_Image"
                        MouseDown="On_Knight_Image_Mouse_Down"
                        Source="/Assets/KnightW.png"/>

            </UniformGrid>
        </Grid>
        
    </Border>
</UserControl>
